script Route204_EventScript_Sarah {
	 trainerbattle_single(
		TRAINER_SARAH,
		Route204_Text_SarahIntro,
        Route204_Text_SarahDefeated
	)
	msgbox(Route204_Text_SarahPostBattle, MSGBOX_AUTOCLOSE)
	end
}

