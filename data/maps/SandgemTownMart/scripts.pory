mapscripts SandgemTownMart_MapScripts{
}

script SandgemTown_Mart_EventScript_Clerk {
	lock
	faceplayer
	message(gText_HowMayIServeYou)
	waitmessage
	pokemart(SandgemTown_Mart)
	msgbox(gText_PleaseComeAgain)
	release
	end
}

mart SandgemTown_Mart {
	ITEM_POKE_BALL
	ITEM_POTION
	ITEM_ANTIDOTE
	ITEM_PARALYZE_HEAL
}

script SandgemTown_Mart_EventScript_SchoolKid {
	lock

	faceplayer
	msgbox("If you come across a Pokémon you've\n"
			"just gotta have, toss a Poké Ball!\p"
			"Never leave home without one!", MSGBOX_AUTOCLOSE)
	release
}

script SandgemTown_Mart_EventScript_Man {
	lock

	faceplayer
	msgbox("If a Pokémon loses all its HP,\n"
			"it can't battle anymore.\p"
			"I'm buying lots of Potions to avoid\n"
			"having that happen!", MSGBOX_AUTOCLOSE)
	release
}