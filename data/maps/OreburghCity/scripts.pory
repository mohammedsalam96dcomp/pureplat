}

script OreburghCity_EventScript_BattleGirl2 {
    lock
    faceplayer
    msgbox("Natural time capsules buried many,\n"
            "many years ago. . .\p"
            "That's what Fossils are.", MSGBOX_AUTOCLOSE)
