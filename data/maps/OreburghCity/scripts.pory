const LOCALID_YOUNGSTER = 1
mapscripts OreburghCity_MapScripts {}

script OreburghCity_EventScript_GuideToGym {
    lock

    playse(SE_PIN)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_in_place_down))
    applymovement(LOCALID_YOUNGSTER, moves(emote_exclamation_mark, delay_16*3))
    waitmovement(LOCALID_YOUNGSTER)
    waitse

    getplayerxy(VAR_TEMP_1, VAR_TEMP_2)

    if(var(VAR_TEMP_2) == 13) {
        applymovement(LOCALID_YOUNGSTER, moves(walk_up*2))
    } elif (var(VAR_TEMP_2) == 14) {
        applymovement(LOCALID_YOUNGSTER, moves(walk_up))
    } else {
        applymovement(LOCALID_YOUNGSTER, moves(walk_in_place_up))
    }
    waitmovement(LOCALID_YOUNGSTER)

    msgbox("Howdy, Trainer!\p"
            "Huh? Uh-oh!\n"
            "You don't have a single Gym Badge?\p"
            "You'd better do something about that!\n"
            "I'll take you to the Pokémon Gym.", MSGBOX_AUTOCLOSE)

    if(var(VAR_TEMP_2) == 13) {
        applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_down, walk_right, walk_down*8, walk_right *12))
        applymovement(LOCALID_YOUNGSTER, moves(walk_right, walk_down*8, walk_right*13, walk_in_place_left)) 
    } elif (var(VAR_TEMP_2) == 14) {
        applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_down, walk_right, walk_down*7, walk_right *12))
        applymovement(LOCALID_YOUNGSTER, moves(walk_right, walk_down*7, walk_right*13, walk_in_place_left)) 
    } else {
        applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_down, walk_right, walk_down*6, walk_right *12))
        applymovement(LOCALID_YOUNGSTER, moves(walk_right, walk_down*6, walk_right*13, walk_in_place_left)) 
    }
    waitmovement(LOCALID_YOUNGSTER)

    msgbox("Huh?\n"
            "There's someone there.", MSGBOX_AUTOCLOSE)

    setobjectxyperm(LOCALID_YOUNGSTER, 28, 22)
    setvar(VAR_OREBURGH_CITY_STATE, 2)
    release
}

script OreburghCity_EventScript_Youngster {
    lock
    faceplayer 
    msgbox("Is that guy in front of the Gym\n"
            "your friend?\p"
            "He's sort of twitchy and impatient.", MSGBOX_AUTOCLOSE)
    release
}

script OreburghCity_EventScript_Worker {
    lock
    faceplayer 
    msgbox("These vents exchange the hot air\n"
            "down below with the fresh air outside.\p"
            "Looking down them gives me the urge\n"
            "to start yelling into 'em! Hello!", MSGBOX_AUTOCLOSE)
    release
}

script OreburghCity_EventScript_Rival {
    lock
    faceplayer 
    if(var(VAR_OREBURGH_CITY_STATE) == 2) {
        msgbox("{SPEAKER NAME_BARRY}Hunh?\p"
                "Oh, it's you, {PLAYER}!\n"
                "You finally got here?\l"
                "You're slow like always.\p"
                "But anyway, the Gym Leader's tough!\n"
                "Like, seriously serious!\p"
                "If the Gym Leader's this tough,\n"
                "I wonder how he compares to my dad. . .\p"
                "Huh?\n"
                "I just drifted there.\p"
                "Anyway, the Gym Leader's gone off\n"
                "to the coal mine.\p"
                "If you want to take on the Gym Leader,\n"
                "you'd better go off to the mine!", MSGBOX_AUTOCLOSE)
        setvar(VAR_OREBURGH_CITY_STATE, 3)
    } else {
        msgbox("{SPEAKER NAME_BARRY}I told you, the Gym\n"
                "Leader went down to the Oreburgh Mine.\p"
                "If you want to take on the Gym Leader,\n"
                "you'd better go off to the mine!", MSGBOX_AUTOCLOSE)
    }
    release
    
}

script OreburghCity_EventScript_Guitarist {
    lock
    faceplayer
    msgbox("Have you seen the vents?\n"
            "They release steam from down below.", MSGBOX_AUTOCLOSE)
    release
}

script OreburghCity_EventScript_Girl {
    lock
    faceplayer 
    msgbox("The Gym Leader went off to work in\n"
            "the mine.", MSGBOX_AUTOCLOSE)
    release
}

script OreburghCity_EventScript_Camper {
    lock
    faceplayer 
    msgbox("When I run around with my Running\n"
            "Shoes on, I'm the center of attention!\p"
            ". . .At least that's what it feels like.\n"
            "There's always someone looking at me.", MSGBOX_AUTOCLOSE)
    release
}

script OreburghCity_EventScript_BattleGirl1 {
    lock
    faceplayer
    msgbox("TMs are single use only, but HMs\n"
            "can be used over and over.\p"
            "It's tricky trying to decide which\n"
            "Pokémon should learn what moves.", MSGBOX_AUTOCLOSE)
    release
}

