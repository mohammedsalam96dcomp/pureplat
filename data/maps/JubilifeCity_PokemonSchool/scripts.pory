const LOCALID_BARRY = 1

mapscripts JubilifeCity_PokemonSchool_MapScripts{
}


script JubilifeCity_PokemonSchool_EventScripts_Items {
	lock
	faceplayer
	msgbox("Pokémon are smart enough to use\n"
			"items they're hiding.\p"
			"But they won't know what to do with\n"
			"man-made items like Potions and\l"
			"Antidotes.", MSGBOX_AUTOCLOSE)
	release
}

script JubilifeCity_PokemonSchool_EventScripts_Essay {
	lock
	faceplayer
	msgbox("I wrote an essay in my notebook on\n"
			"what makes a true Pokémon Trainer.", MSGBOX_AUTOCLOSE)
	release
}

script JubilifeCity_PokemonSchool_EventScripts_Types {
	lock
	faceplayer
	msgbox("We learned about Pokémon types\n"
			"today. Umm. . .\p"
			"Grass is weak to Fire,\p"
			"Fire is weak to Water,\p"
			"and Water is weak to Grass!", MSGBOX_AUTOCLOSE)
	release
}

script JubilifeCity_PokemonSchool_EventScripts_Pace {
	lock
	faceplayer
	msgbox("It's perfectly fine for Trainers and\n"
			"Pokémon to develop at their own pace.\p"
			"If there is anything you're not familiar\n"
			"with, you can look it up here.", MSGBOX_AUTOCLOSE)
	release
}

script JubilifeCity_PokemonSchool_EventScripts_SchoolBoy {
	lock
	faceplayer

	if(!flag(FLAG_DEFEATED_TRAINER_SCHOOL_BOY)) {
		msgbox("Doing it is the best way to learn!\n"
				"Can we get a battle with you?", MSGBOX_YESNO)
		if(var(VAR_RESULT) == 1) {
			goto(JubilifeCity_PokemonSchool_EventScripts_Harrison)
		} else {
			msgbox("Aww! But battling is the best way\n"
					"to learn about Pokémon!", MSGBOX_AUTOCLOSE)
		}
	} else{
		goto(JubilifeCity_PokemonSchool_EventScripts_DefeatedSchoolBoy)
	}

	release
}

script JubilifeCity_PokemonSchool_EventScripts_SchoolGirl {
	lock
	faceplayer

	if(!flag(FLAG_DEFEATED_TRAINER_SCHOOL_GIRL)) {
		msgbox("I just became friends with my\n"
				"Pokémon.\p"
				"I'm not sure if we can do this\n"
				"properly, but may we battle?", MSGBOX_YESNO)
		if (var(VAR_RESULT) == 1) {
			goto(JubilifeCity_PokemonSchool_EventScripts_Christine)
		} else {
			msgbox("Boo!\n"
					"Where's your sense of adventure?\p"
					"Don't be shy about talking to people\n"
					"and getting into battles!", MSGBOX_AUTOCLOSE)
		}
	} else {
		msgbox("I wonder if we could have done better\n"
				"against you?\p"
				"Like if I used Potions right when we\n"
				"needed to.", MSGBOX_AUTOCLOSE)
	}

	release
}


script JubilifeCity_PokemonSchool_EventScripts_Harrison {
	trainerbattle_single(
		TRAINER_HARRISON,
		format("Go!\nMy Pokémon, go!"),
		format("Ugh. . .\nI didn't use items effectively."), 
		JubilifeCity_PokemonSchool_EventScripts_DefeatedSchoolBoy
	)
}


			
script JubilifeCity_PokemonSchool_EventScripts_DefeatedSchoolBoy {
	lock
	if(flag(FLAG_DEFEATED_TRAINER_SCHOOL_GIRL)) {
		if(!flag(FLAG_RECEIVED_POTION_SCHOOL)) {
			msgbox("Whew! You're really good!\p"
				"We've been studying every day. but\n"
				"we were no match for you at all!\p"
				"You'd be able to use this Potion\n"
				"properly. Here you go!")
			giveitem(ITEM_POTION)
			if (var(VAR_RESULT) == FALSE) {
				call(Common_EventScript_BagIsFull)
			} else {
				setflag(FLAG_RECEIVED_POTION_SCHOOL)
				msgbox(GotPotion, MSGBOX_AUTOCLOSE)
			}
		} else {
			msgbox(GotPotion, MSGBOX_AUTOCLOSE)
		}
	} else {
		msgbox("It's hard to win if you don't have\n"
		"some Pokémon to choose from.", MSGBOX_AUTOCLOSE)
	}
	setflag(FLAG_DEFEATED_TRAINER_SCHOOL_BOY)
	release
}

script JubilifeCity_PokemonSchool_EventScripts_Christine {
	trainerbattle_single(
		TRAINER_CHRISTINE,
		format("I need to try the things I learned\nbefore I forget them!"),
		format("I like to study alot. . .\nI thought I could win. . ."), 
		JubilifeCity_PokemonSchool_EventScripts_DefeatedSchoolGirl
	)
}

script JubilifeCity_PokemonSchool_EventScripts_DefeatedSchoolGirl {
	lock
	if(!flag(FLAG_DEFEATED_TRAINER_SCHOOL_BOY)) {
		msgbox("I wonder if we could have done better\n"
				"against you?\p"
				"Like if I used Potions right when we\n"
				"needed to.", MSGBOX_AUTOCLOSE)
	} else {
		msgbox("We were actually confident that we\n"
			"would do pretty good.\p"
			"But I'm completely impressed by how\n"
			"tough you are.\p"
			"If you'd like, talk to my friend and\n"
			"get a nice item from him.", MSGBOX_AUTOCLOSE)
	}
	setflag(FLAG_DEFEATED_TRAINER_SCHOOL_GIRL)
	release
}


text GotPotion {
	"When a Potion is used, it restores the\n"
	"HP, the health, of a Pokémon.\p"
	"Being a good Trainer isn't only about\n"
	"ordering your Pokémon around.\p"
	"A superior Trainer knows how to use\n"
	"items to the full advantage!"
}

script JubilifeCity_PokemonSchool_SignScript_ChockFull {
	lock
	msgbox("It's chock-full of Pokémon books and\n"
			"photo collections.")
	release
}

script JubilifeCity_PokemonSchool_SignScript_PictureBooks {
	lock
	msgbox("It's lined with Pokémon picture books.")
	release
}

script JubilifeCity_PokemonSchool_SignScript_Notebook {
	lock
	msgbox("It's a notebook filled with writing.\n"
			"Let's see. . .\p"
			"Pokémon are to be caught using\n"
			"Poké Balls.\p"
			"Up to six Pokémon can accompany\n"
			"a Trainer.\p"
			"A Trainer is someone who catches\n"
			"Pokémon, raises them, and battles\l"
			"with them.\p"
			"A Trainer's mission is to defeat the\n"
			"strong Trainers who await challengers\l"
			"in Pokémon Gyms.")
	release
}

script JubilifeCity_PokemonSchool_SignScript_Board {
	lock
	msgbox("The blackboard lists status changes\n"
			"that may affect Pokémon in battle.")
	while {
		message("Which would you like to read about?")
		multichoicegrid(0, 0, MULTI_STATUS, 2, 0)
		switch(var(VAR_RESULT)) {
			case 0:
				msgbox("If a Pokémon is poisoned, it will\n"
						"steadily lose HP.\p"
						"The effects of poison remain after\n"
						"a battle.\p"
						"A poisoned Pokémon's HP will drop\n"
						"while it is traveling.\p"
						"Heal a poisoning using an Antidote.")
			case 1:
				msgbox("A burn reduces the Attack stat and\n"
						"steadily reduces the victim's HP.\p"
						"A burn lingers after battle.\n"
						"Cure a burn using a Burn Heal.")
			case 2:
				msgbox("If a Pokémon becomes paralyzed,\n"
						"its Speed stat drops.\p"
						"In addition, it may not be able to\n"
						"move while it is in battle.\p"
						"Paralysis remains after battle.\n"
						"Cure it using a Paralyz Heal.")
			case 3:
				msgbox("If a Pokémon is frozen, it becomes\n"
						"completely helpless.\p"
						"The Pokémon may thaw out on its own,\n"
						"but if a battle ends while it is\l"
						"frozen, it will stay frozen.\p"
						"Thaw it out using an Ice Heal.")
			case 4:
				msgbox("If a Pokémon falls asleep, it will be\n"
						"unable to attack.\p"
						"The Pokémon may wake up on its own,\n"
						"but if a battle ends while it is\l"
						"sleeping, it will stay asleep.\p"
						"Wake it up using an Awakening.")
			case 5: 
				closemessage
				end
			case MULTI_B_PRESSED:
				closemessage
				end
		}
	}

	release
}



script JubilifeCity_PokemonSchool_EventScript_Barry {
	lock
	faceplayer
	msgbox("{SPEAKER NAME_BARRY}Hey, {PLAYER}!\n"
			"Did you come to study, too?\p"
			"I went ahead and memorized everything\n"
			"that was up on the blackboard.\p"
			"After all, it's the Trainer's job to\n"
			"avoid having their precious Pokémon\l"
			"hurt in battle, right?\p"
			"So {PLAYER}, what brings you?\n"
			"Huh?\l"
			"You've got something for me?")
	playfanfare(MUS_OBTAIN_ITEM)
	msgbox("{SPEAKER NAME_NONE}{PLAYER} delivered the Parcel.")
	waitfanfare
	removeitem(ITEM_PARCEL, 1)
	msgbox("{SPEAKER NAME_BARRY}So, what is this. . .?\p"
			"Score!\n"
			"It's a Town Map!\p"
			"Huh?!\n"
			"Why are there two in here?\p"
			"I like it a lot, but I don't need two.\n"
			"Here, {PLAYER}, you take one!")
	giveitem(ITEM_TOWN_MAP)
	msgbox("{SPEAKER NAME_BARRY}Hmm. . .\p"
			"Well, according to the Town Map,\n"
			"I guess Oreburgh City is where\l"
			"I should be going next.\p"
			"There's a Gym, so it'd be perfect for\n"
			"raising the Pokémon I just caught.\p"
			"Well, I'm on the road to becoming\n"
			"the greatest Trainer of all time!\p"
			"See you around!", MSGBOX_AUTOCLOSE)
	
	specialvar(VAR_RESULT, GetPlayerFacingDirection)


	if (var(VAR_RESULT) == DIR_NORTH) {
		applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_in_place_right, walk_in_place_down))
		applymovement(LOCALID_BARRY, moves(walk_fast_right, walk_fast_down*6))
	} else {
		applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_in_place_down))
		applymovement(LOCALID_BARRY, moves(walk_fast_down*2, walk_fast_right, walk_fast_down*4))
	}	
	waitmovement(LOCALID_BARRY)

	playse(SE_EXIT)
	setflag(FLAG_HIDE_BARRY_POKEMON_SCHOOL)
	removeobject(LOCALID_BARRY)
	waitse

	clearflag(FLAG_HIDE_POKETCH_EMPLOYEE_JUBILIFE)
	clearflag(FLAG_HIDE_POKETCH_CLOWNS)
	setvar(VAR_JUBILIFE_CITY_STATE, 3)

	release
}