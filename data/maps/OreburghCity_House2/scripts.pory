mapscripts OreburghCity_House2_MapScripts {}

script OreburghCity_House2_EventScript_Girl {
    lock
    faceplayer
    msgbox("Roark is a user of Rock-type Pokémon.\p"
            "Don't you think Rock-Type Pokémon are\n"
            "nice? I like how lumpy they are!", MSGBOX_AUTOCLOSE)
    release
}

script OreburghCity_House2_EventScript_Hiker {
    lock
    faceplayer
    msgbox("Roark is our town's Gym Leader.\p"
            "He may be young, but he keeps the\n"
            "mine running safely and efficiently.", MSGBOX_AUTOCLOSE)
    release
}
 