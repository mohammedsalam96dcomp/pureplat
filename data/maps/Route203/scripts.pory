const LOCALID_BARRY = 1

mapscripts Route203_MapScripts{
	MAP_SCRIPT_ON_TRANSITION: JubilifeCity_EventScript_OnTransition
}

script Route203_EventScript_RivalBattle {
	lock

	playse(SE_PIN)
	applymovement(LOCALID_BARRY, moves(delay_16, emote_exclamation_mark, delay_16*2))
	waitmovement(LOCALID_BARRY)
	waitse

	playbgm(MUS_DP_RIVAL, 0)
	getplayerxy(VAR_TEMP_1, VAR_TEMP_2) 

	if(var(VAR_TEMP_2) == 22) {
		applymovement(LOCALID_BARRY, moves(walk_fast_left*4))
	} elif(var(VAR_TEMP_2) == 23) {
		applymovement(LOCALID_BARRY, moves(walk_fast_left*2, walk_fast_down, walk_fast_left*2))
	} elif(var(VAR_TEMP_2) == 24) {
		applymovement(LOCALID_BARRY, moves(walk_fast_left*2, walk_fast_down*2, walk_fast_left*2))
	} else {
		applymovement(LOCALID_BARRY, moves(walk_fast_left*2, walk_fast_down*3, walk_fast_left*2))
	}
	waitmovement(LOCALID_BARRY)

	msgbox("{SPEAKER NAME_BARRY}Hey! {PLAYER}!"\n
			"Tell me you got a little tougher!\p"
			"Me? Do you even need to ask?\n"
			"Of course I got tougher!\p"
			"Come on!\n"
			"I'll demonstrate it to you!", MSGBOX_AUTOCLOSE)


	switch(var(VAR_STARTER_MON)){
		case 0:
			trainerbattle_no_intro(TRAINER_RIVAL_ROUTE_203_TURTWIG, Rival_Route_203_TurtwigDefeat)
		case 1:
			trainerbattle_no_intro(TRAINER_RIVAL_ROUTE_203_CHIMCHAR, Rival_Route_203_ChimcharDefeat)
		case 2:
			trainerbattle_no_intro(TRAINER_RIVAL_ROUTE_203_PIPLUP, Rival_Route_203_PiplupDefeat)
	}

	msgbox("{SPEAKER NAME_BARRY}Waah!\n"
			"What do you mean I lost?!\p"
			"Well, that's it!\n"
			"That's the last time I'll ever lose!\p"
			"I'm going to be the world's toughest\n"
			"Trainer, and you know it!\p"
			"The first thing to do is take on\n"
			"the Oreburgh City Pokémon Gym!\p"
			"I'm gonna toughen up for that,\n"
			"totally!", MSGBOX_AUTOCLOSE)

	applymovement(LOCALID_BARRY, moves(walk_fast_right*7, delay_16))
	waitmovement(LOCALID_BARRY)

	setflag(FLAG_HIDE_ROUTE_203_BARRY)
	removeobject(LOCALID_BARRY)
	setvar(VAR_ROUTE203_STATE, 2)

	release
}

script Route203_EventScript_Michael {
 	trainerbattle_single(
		TRAINER_MICHAEL,
		Route203_Text_MichaelIntro,
        Route203_Text_MichaelDefeated
	)
	msgbox(Route203_Text_MichaelPostBattle, MSGBOX_AUTOCLOSE)
	end
}

script Route203_EventScript_Lass {
	lock
	faceplayer
	msgbox("Your favorite Pokémon should be placed\n"
			"at the top left of your party list.\p"
			"That way, it will be the first to go out\n"
			"in a battle.", MSGBOX_AUTOCLOSE)
	release
}

