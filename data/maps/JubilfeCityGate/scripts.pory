mapscripts JubilfeCityGate_MapScripts {}

script JubilifeCite_Gate_EvenScript_Officer {
    lock
    faceplayer
    msgbox("Route 218 up ahead is a great fishing\n"
            "hole that's almost unknown to people.", MSGBOX_AUTOCLOSE)
    release
}

script JubilifeCite_Gate_EvenScript_Fisherman {
    lock
    faceplayer

    checkitem(ITEM_OLD_ROD, 1)

    if(var(VAR_RESULT) == 1) {
        goto(JubilifeCite_Gate_EvenScript_Fisherman_Tips)
    } else {
        msgbox("Yes, sir!\n"
            "An Old Rod is a good thing!\p"
            "You think so too, am I right?",MSGBOX_YESNO)
        if(var(VAR_RESULT) == 1) {
            msgbox("Yes! Good answer!\n"
                    "We can be friends!\p"
                    "Here you go.\n"
                    "That's my Old Rod!")
            giveitem(ITEM_OLD_ROD)
            call(JubilifeCite_Gate_EvenScript_Fisherman_Tips)
        } else {
            msgbox("Oh, really?\n"
                "You don't like to fish?". MSGBOX_AUTOCLOSE)
        }
    }

    // release
}

script JubilifeCite_Gate_EvenScript_Fisherman_Tips {
    lock
    // faceplayer
    msgbox("You should fish wherever there is\n"
                "a body of water.\p"
                "Oh, and by the way, did you need\n"
                "any tips on using that fishing rod?", MSGBOX_YESNO)
    if(var(VAR_RESULT) == 1) { 
        msgbox("First, you face any body of water,\n"
                "then you use your fishing rod.\p"
                "Next, you focus!\n"
                "If a Pokémon bites, “!” appears.\l"
                "That's your cue to reel it in!", MSGBOX_AUTOCLOSE)
    } else {
        msgbox("When you're fishing for Pokémon,\n"
                "the first hurdle is getting a bite.\p"
                "When you reel the Pokémon in, you've\n"
                "got to battle it.\p"
                "So, fishing gives you twice the fun!", MSGBOX_AUTOCLOSE)
    }
    
    release
}