mapscripts OreburghCity_Building3_2F_MapScripts {}

script OreburghCity_Building3_1F_EventScript_Youngster {
    lock
    faceplayer
    if(!flag(FLAG_RECEIVED_OREBURGH_GREAT_BALL)) {
        msgbox("Wow. . . Your Pokémon's eyes are\n"
            "twinkling brightly!\p"
            "Seeing that makes me happy!\n"
            "Here, I want you to have this!")
        giveitem(ITEM_GREAT_BALL, 1)
        setflag(FLAG_RECEIVED_OREBURGH_GREAT_BALL)
    }
    msgbox("You know how Pokémon stay inside\n"
            "their Poké Balls?\p"
            "I try to think about what would be\n"
            "the best Poké Balls for them.", MSGBOX_AUTOCLOSE)
    release
}


script OreburghCity_Building3_1F_EventScript_GentleMan {
    lock
    faceplayer
    msgbox("The Oreburgh Mine is operated\n"
            "with the utmost care.\p"
            "We avoided causing any damage to\n"
            "the natural habitats of Pokémon.", MSGBOX_AUTOCLOSE)
    release
}

script OreburghCity_Building3_1F_EventScript_Scientist {
    lock
    faceplayer
    msgbox("Coal is carred out of Oreburgh Mine on\n"
            "a fully automated system.\p"
            "Machines do all the work automatically.\n"
            "So, it's all very easy.", MSGBOX_AUTOCLOSE)
    release
}
