			setflag(FLAG_POKETCH_COUPON_2)
		} else {
			msgbox("Bzzzzt!\n"
					"That's the wrong answer. . .", MSGBOX_AUTOCLOSE)
		}
	} else {
		msgbox(Clown2Correct)
	}
