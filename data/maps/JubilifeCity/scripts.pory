}

script JubilifeCity_EventScript_Clown3 {
	lock

	faceplayer

	if(var(VAR_JUBILIFE_CITY_STATE) == 2) {
		msgbox("Hi, there. You should stick around.\n"
				"We're doing a Pokétch campaign soon.\p"
				"Before it starts, I think you should\n"
				"brush up at the Trainers' School.", MSGBOX_AUTOCLOSE)
	} else {
		if(flag(FLAG_POKETCH_COUPON_3)) {
			msgbox(Clown3Correct)
		} else {
			msgbox("Hi! I'm a Pokétch campaign clown!\n"
				"Let's roll out my question!\p"
				"Can a Pokémon hold an item?", MSGBOX_YESNO)
			if(var(VAR_RESULT) == 1) {
				msgbox("Ding-ding!\n"
						"You're absolutely correct!")
				msgbox(Clown3Correct)
				msgbox("Here you go!\n"
						"Your Pokétch Coupon!")
				giveitem(ITEM_COUPON_THREE)
				setflag(FLAG_POKETCH_COUPON_3)
				setobjectxyperm(LOCALID_EMPLOYEE, 46, 30)
			} else {
				msgbox("Bzzzzt!\n"
					"That's the wrong answer. . .", MSGBOX_AUTOCLOSE)
			}
		}
	}
	release
}


script JubilifeCity_EventScript_Looker {
	lock
	faceplayer
	if (var(VAR_JUBILIFE_CITY_STATE) == 4) {
		msgbox("{SPEAKER NAME_LOOKER}Ah, it is you! Have no fear.\n"
				"There are no shady characters about.\p"
				"Incidentally, have you not obtained\n"
				"a Pokétch?\p"
				"I believe a Pokétch is now free in\n"
				"exchange for some Coupons?", MSGBOX_AUTOCLOSE)
	} else {
		msgbox("{SPEAKER NAME_LOOKER}Ah, it is you! Have no fear.\n"
				"There are no shady characters about.\p"
				"Incidentally, have you visited the\n"
				"Trainers' School?\p"
				"Did your friend not guide you there\n"
				"earlier?", MSGBOX_AUTOCLOSE)
	}
	release
}
text Clown1Correct {
	"Pokémon grow stronger by defeating\n"
	"other Pokémon in battle.\p"
	"Some Pokémon even grow into an\n"
	"entirely different form in a process\l"
	"known as evolution."
}

text Clown2Correct {
	"If the Pokémon's type matches its\n"
	"move's type, that move is made much\l"
	"more powerful!"
}

text Clown3Correct {
	"A Pokémon may hold a single item.\p"
	"Some items become effective as soon\n"
	"as they are held by a Pokémon.\p"
	"Berries are eaten by Pokémon as\n"
	"necessary during battle."
}