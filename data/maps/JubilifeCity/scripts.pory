	release
}

script JubilifeCity_EventScript_AceTrainerF {
	lock

	faceplayer
	msgbox("When you walk with your Pokémon,\n"
			"they gradually grow friendlier.", MSGBOX_AUTOCLOSE)
	release
}


script JubilifeCity_EventScript_AceTrainerM {
	lock

	faceplayer
	msgbox("Hiya, where'd you come from?\p"
			". . .\p"
			"Twinleaf Town, huh. . .\n"
			"It's a nice place. Quiet and all.\p"
			"Jubilife City is a big place, so it\n"
			"might be a bit of a shock to you.", MSGBOX_AUTOCLOSE)
	release
}

script JubilifeCity_EventScript_Clown1 {
	lock
	faceplayer

	if(!flag(FLAG_POKETCH_COUPON_1)) {
		msgbox("Hi! I'm a Pokétch campaign clown!\n"
				"Let's roll out my question!\p"
				"Does a Pokémon grow by defeating\n"
				"others and gaining Exp. Points?", MSGBOX_YESNO)
		if(var(VAR_RESULT) == 1) {
			msgbox("Ding-ding!\n"
					"You're absolutely correct!")
			msgbox(Clown1Correct)
			msgbox("Here you go!\n"
					"Your Pokétch Coupon!")
			setflag(FLAG_POKETCH_COUPON_1)
			giveitem(ITEM_COUPON_ONE)
		} else {
			playse(SE_FAILURE)
			msgbox("Bzzzzt!\n"
					"That's the wrong answer. . .", MSGBOX_AUTOCLOSE)
			waitse
		}
	} else {
		msgbox(Clown1Correct)
	}
	release
}

script JubilifeCity_EventScript_Clown2 {
	lock
	faceplayer

	if(!flag(FLAG_POKETCH_COUPON_2)) {
		msgbox("Hi! I'm a Pokétch campaign clown!\n"
				"Let's roll out my question!\p"
				"Just like Pokémon types, the moves\n"
				"of Pokémon also have types?", MSGBOX_YESNO)
		if(var(VAR_RESULT) == 1) {
			msgbox("Ding-ding!\n"
